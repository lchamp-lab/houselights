<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device (Android 11 and earlier; data_extraction_rules.xml covers Android 12+):
     the library and settings hold sealed secrets whose key stays in this device's Keystore. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
